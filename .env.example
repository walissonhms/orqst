# ORQST environment template.
#
# ORQST reads environment variables directly. It does NOT load .env
# automatically. Export the values in your shell, or start the built bridge
# with an env file:
#
#   node --env-file=.env dist/bridge.mjs
#
# Every variable is optional; the defaults below match the code.
# Invalid numeric values fail startup instead of being silently ignored.

# Loopback HTTP and WebSocket port. Integer 1024-65535.
ORQST_PORT=4317

# Directory that holds orqst.db. Created with mode 0700 if missing.
# Default: ~/.orqst
# ORQST_DATA_DIR=/absolute/path/to/orqst-data

# Codex session root to observe. Must contain .jsonl session files.
# Default: ${CODEX_HOME:-~/.codex}/sessions
# ORQST_CODEX_SESSIONS=/absolute/path/to/codex/sessions

# Event-detail retention in days. Integer 1-3650.
# Session summaries and token totals are retained after details expire.
ORQST_RETENTION_DAYS=30

# Fallback filesystem scan interval in milliseconds. Integer 500-60000.
# Used in addition to the file watcher.
ORQST_POLL_MS=3000

# Development mode. Set to 1 only when using the Vite dev server; it trusts
# the http://127.0.0.1:5173 and http://localhost:5173 origins.
# ORQST_DEV=1

# Optional Codex home. Only used to derive the default session root.
# CODEX_HOME=/absolute/path/to/.codex

# There are no secrets, API keys, telemetry endpoints, or cloud credentials to
# configure. ORQST does not upload data and does not require an account.
