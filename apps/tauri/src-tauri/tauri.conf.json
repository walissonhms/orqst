{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORQST Preview",
  "version": "0.1.0",
  "identifier": "dev.orqst.desktop.preview",
  "build": {
    "beforeDevCommand": "cd ../.. && pnpm build:tauri-resources",
    "beforeBuildCommand": "cd ../.. && pnpm build:tauri-resources",
    "frontendDist": "../dist/dashboard"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        {
          "identifier": "owned-structured-agents",
          "description": "Only the dedicated native agent document can review structured communication.",
          "local": true,
          "windows": ["managed-agents"],
          "permissions": ["allow-agents-request"]
        },
        {
          "identifier": "owned-terminals",
          "description": "Only dedicated local terminal webviews can access the private native terminal client.",
          "local": true,
          "webviews": ["terminal-*"],
          "permissions": ["allow-terminal-request", "allow-terminal-view"]
        }
      ],
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/orqst-node"],
    "resources": {
      "../dist/core/": "core/",
      "../dist/dashboard/": "dashboard/",
      "../dist/licenses/": "licenses/",
      "../dist/terminal/": "terminal/",
      "../dist/agents/": "agents/"
    },
    "icon": [
      "../../desktop/resources/icons/orqst-32.png",
      "../../desktop/resources/icons/orqst-128.png",
      "../../desktop/resources/icons/orqst.icns",
      "../../desktop/resources/icons/orqst.ico"
    ]
  }
}
