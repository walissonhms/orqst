{
  "name": "orqst",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @orqst/dashboard build && node scripts/build.mjs",
    "start": "node dist/bridge.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate:local": "tsx scripts/validate-local.ts",
    "validate:live": "tsx scripts/validate-live.ts",
    "runtime:install": "node scripts/install-runtime.mjs",
    "service:plan": "node scripts/service.mjs plan",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.14.0",
    "esbuild": "^0.28.2",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "@orqst/protocol": "workspace:*",
    "@orqst/shared": "workspace:*",
    "@orqst/database": "workspace:*",
    "@orqst/adapter-codex": "workspace:*"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
