{
  "name": "orqst",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @orqst/dashboard build && node scripts/build.mjs && pnpm build:desktop",
    "start": "node dist/bridge.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate:local": "tsx scripts/validate-local.ts",
    "validate:live": "tsx scripts/validate-live.ts",
    "runtime:install": "node scripts/install-runtime.mjs",
    "service:plan": "node scripts/service.mjs plan",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "dev:desktop": "pnpm build:desktop && pnpm desktop",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "pnpm --filter @orqst/desktop exec electron .",
    "dev:tauri": "pnpm --dir apps/tauri exec tauri dev",
    "build:tauri": "pnpm --dir apps/tauri exec tauri build",
    "build:tauri-resources": "pnpm --filter @orqst/dashboard build && node scripts/build-tauri-resources.mjs",
    "test:tauri": "cargo test --manifest-path apps/tauri/src-tauri/Cargo.toml",
    "accept:tauri-agents": "tsx scripts/accept-tauri-agents.ts",
    "accept:tauri-files": "tsx scripts/accept-tauri-files.ts",
    "accept:tauri-core": "tsx scripts/accept-tauri-core.ts",
    "accept:tauri-coexistence": "tsx scripts/accept-tauri-coexistence.ts",
    "accept:tauri-terminals": "tsx scripts/accept-tauri-terminals.ts",
    "accept:tauri-terminal-mcp": "tsx scripts/accept-tauri-terminal-mcp.ts",
    "test:desktop": "tsx scripts/smoke-desktop.ts",
    "accept:terminal-pty": "tsx scripts/accept-terminal-pty.ts",
    "accept:terminal-native": "tsx scripts/accept-terminal-native.ts",
    "terminal:setup": "tsx scripts/setup-managed-terminal.ts",
    "terminal:setup:opencode": "tsx scripts/setup-opencode-terminal.ts",
    "terminal:setup:claude": "tsx scripts/setup-claude-terminal.ts",
    "terminal:plan:opencode": "tsx scripts/plan-opencode-terminal.ts",
    "terminal:discover": "tsx scripts/discover-local-clis.ts",
    "accept:managed-agents": "tsx scripts/accept-managed-agents.ts",
    "accept:managed-terminal": "tsx scripts/accept-managed-terminal.ts",
    "accept:terminal-pair": "tsx scripts/accept-terminal-pair.ts",
    "accept:terminal-cycles": "tsx scripts/accept-terminal-cycles.ts",
    "accept:terminal-gestures": "tsx scripts/accept-terminal-gestures.ts",
    "accept:terminal-creation": "tsx scripts/accept-terminal-creation.ts",
    "accept:terminal-selection": "tsx scripts/accept-terminal-selection.ts",
    "accept:terminal-team": "tsx scripts/accept-terminal-team.ts",
    "accept:terminal-reuse": "tsx scripts/accept-terminal-reuse.ts"
  },
  "devDependencies": {
    "@orqst/core": "workspace:*",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.14.0",
    "esbuild": "^0.28.2",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "@orqst/protocol": "workspace:*",
    "@orqst/shared": "workspace:*",
    "@orqst/database": "workspace:*",
    "@orqst/adapter-codex": "workspace:*",
    "node-pty": "1.1.0"
  },
  "dependencies": {
    "chokidar": "^6.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
